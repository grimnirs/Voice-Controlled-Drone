<link name="flow_link">
  <pose>0 0 0 0 1.5708 0</pose>

  <sensor name="optical_flow" type="camera">
    <always_on>1</always_on>
    <update_rate>30</update_rate>
    <visualize>false</visualize>

    <camera>
      <horizontal_fov>1.0</horizontal_fov>

      <image>
        <width>64</width>
        <height>64</height>
        <format>L8</format>
      </image>

      <clip>
        <near>0.1</near>
        <far>50</far>
      </clip>
    </camera>

    <plugin name="optical_flow_plugin"
        filename="libArduPilotOpticalFlowPlugin.so">
      <robotNamespace/>
      <cameraName>optical_flow</cameraName>
      <frameName>flow_link</frameName>
      <focalLength>0.0028</focalLength>
      <horizontalFov>1.0</horizontalFov>
      <gyroTopic>/imu</gyroTopic>
  
      <fdmAddr>127.0.0.1</fdmAddr>
      <fdmPort>9002</fdmPort>
    </plugin>

  </sensor>
</link>