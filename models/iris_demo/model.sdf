<?xml version='1.0'?>
<sdf version="1.6">
  <model name="iris_demo">
    <include>
      <uri>model://iris_with_standoffs</uri>
    </include>
    
    <plugin name="ArduPilotPlugin" filename="libArduPilotPlugin.so">
      <imuName>iris_with_standoffs::imu_link::imu_sensor</imuName>
      <connectionTimeoutMaxCount>50</connectionTimeoutMaxCount>
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <fdm_port_out>9003</fdm_port_out>
      
      <motorSpeed>
        <joint>iris_with_standoffs::rotor_0_joint</joint>
        <multiplier>838</multiplier>
      </motorSpeed>
      <motorSpeed>
        <joint>iris_with_standoffs::rotor_1_joint</joint>
        <multiplier>838</multiplier>
      </motorSpeed>
      <motorSpeed>
        <joint>iris_with_standoffs::rotor_2_joint</joint>
        <multiplier>838</multiplier>
      </motorSpeed>
      <motorSpeed>
        <joint>iris_with_standoffs::rotor_3_joint</joint>
        <multiplier>838</multiplier>
      </motorSpeed>

      <rangefinder>
        <sensorName>lidar_down</sensorName>
      </rangefinder>
      <proximity>
        <sensorName>lidar_forward</sensorName>
      </proximity>
    </plugin>

    <link name="lidar_forward_link">
      <pose>0.15 0 0.05 0 0 0</pose> <sensor name="lidar_forward" type="ray">
        <update_rate>20</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-1.57</min_angle> <max_angle>1.57</max_angle>  </horizontal>
          </scan>
          <range>
            <min>0.2</min>
            <max>20.0</max>
          </range>
        </ray>
        <always_on>1</always_on>
      </sensor>
    </link>

    <link name="lidar_down_link">
      <pose>0 0 -0.05 0 1.5707 0</pose> <sensor name="lidar_down" type="ray">
        <update_rate>20</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.1</min>
            <max>30.0</max>
          </range>
        </ray>
        <always_on>1</always_on>
      </sensor>
    </link>
    <!--<link name="camera_down_link">
      <pose>0 0 -0.05 0 1.5707 0</pose> <sensor name="camera_down" type="camera">
        <update_rate>30</update_rate>
        <camera name="head">
          <horizontal_fov>1.396</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>-->

    <joint name="lidar_forward_joint" type="fixed">
      <parent>iris_with_standoffs::base_link</parent>
      <child>lidar_forward_link</child>
    </joint>

    <joint name="lidar_down_joint" type="fixed">
      <parent>iris_with_standoffs::base_link</parent>
      <child>lidar_down_link</child>
    </joint>
    <!--<joint name="camera_down_joint" type="fixed">
      <parent>iris::base_link</parent>
      <child>camera_down_link</child>
    </joint>-->
    
  </model>
</sdf>


